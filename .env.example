# ==============================================================================
# TRACE DIGITAL FORENSICS & RECOVERY PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- Google Gemini AI Integration ---
# Provide your official Google Gemini API Key below.
# When empty or omitted, TRACE operates in deterministic offline recovery mode with zero network calls.
GEMINI_API_KEY=

# Configurable ordered model preference queue (comma-separated).
# If the primary model encounters a transient error or is unavailable, TRACE automatically
# falls back to the next supported model in the queue without interrupting forensic workflows.
GEMINI_MODEL_PREFERENCE=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-pro-preview,gemini-3.1-flash-lite,gemini-flash-latest

# Master switch for Gemini AI assistance (true / false)
GEMINI_ENABLE=true

# --- TRACE Forensic Platform Settings ---
# Maximum evidence upload size in bytes (default: 64MB)
TRACE_MAX_EVIDENCE_BYTES=67108864

# Accepted engine modes: auto | real | mock | unavailable
TRACE_RECOVERY_MODE=auto
TRACE_AI_MODE=auto

# Session persistence
TRACE_PERSIST_SESSIONS=false
